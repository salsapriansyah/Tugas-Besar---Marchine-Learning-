# ==========================================
# 10. PROSES PREDIKSI
# ==========================================
if tombol_prediksi:
    if not caption_input.strip():
        st.warning("Silakan masukkan teks caption terlebih dahulu!")
    else:
        try:
            teks_bersih = bersihkan_teks(caption_input)
            fitur_gabungan = teks_bersih + " waktu_posting_jam_" + jam_input

            if jenis_model == "sklearn":
                if hasattr(model, "predict"):
                    estimator = model
                else:
                    estimator = None
                    for key in ["model", "estimator", "pipeline", "classifier"]:
                        kandidat = model.get(key)
                        if hasattr(kandidat, "predict"):
                            estimator = kandidat
                            break

                    if estimator is None:
                        raise ValueError("Classifier tidak ditemukan dalam checkpoint.")

                hasil_prediksi = estimator.predict([fitur_gabungan])[0]

            elif jenis_model == "pytorch":
                st.warning("Model terdeteksi sebagai PyTorch. Arsitektur dan format input model harus disesuaikan dengan proses training.")
                st.stop()

            elif jenis_model == "pytorch_checkpoint":
                st.error("File berisi bobot model PyTorch (state_dict), bukan model utuh.")
                st.stop()

            else:
                raise ValueError("Format model tidak dikenali.")

            # ==================================
