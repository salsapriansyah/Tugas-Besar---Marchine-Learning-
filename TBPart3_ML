FOLDER_PATH = os.path.dirname(os.path.abspath(__file__))
MODEL_PATH = os.path.join(FOLDER_PATH, "DataSosMed.pth")


# ==========================================
# 4. MEMUAT MODEL
# ==========================================
@st.cache_resource
def load_model():
    if not os.path.exists(MODEL_PATH):
        raise FileNotFoundError("File DataSosMed.pth tidak ditemukan!")

    checkpoint = torch.load(
        MODEL_PATH,
        map_location="cpu",
        weights_only=False
    )
    return checkpoint


try:
    model = load_model()
except Exception as e:
    st.error(f"Gagal memuat model: {e}")
    st.stop()


# ==========================================
# 5. PREPROCESSING TEKS
# ==========================================
def bersihkan_teks(teks):
    teks = re.sub(r'http\S+', '', str(teks).lower())
    teks = re.sub(r'[^a-z\s#]', '', teks)
    return " ".join(teks.split())


# ==========================================
# 6. MEMERIKSA FORMAT MODEL
# ==========================================
def periksa_model(model):
    if hasattr(model, "predict"):
        return "sklearn"

    if isinstance(model, dict):
        for key in ["model", "estimator", "pipeline", "classifier"]:
            if key in model:
                kandidat = model[key]
                if hasattr(kandidat, "predict"):
                    return "sklearn"
                if isinstance(kandidat, torch.nn.Module):
                    return "pytorch"

        if "state_dict" in model or "model_state_dict" in model:
            return "pytorch_checkpoint"

    if isinstance(model, torch.nn.Module):
        return "pytorch"

    return "unknown"


jenis_model = periksa_model(model)


